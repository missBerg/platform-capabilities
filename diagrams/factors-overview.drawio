        <mxCell id="1" parent="0" />
        <mxCell id="f1" value="&lt;b&gt;1. Defined Contract&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot; color=&quot;#4B5563&quot;&gt;one versioned API&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F4F7FC;strokeColor=#7A99C7;strokeWidth=1;fontColor=#2E5C9E;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry width="124" height="84" as="geometry" x="40" y="40" /></mxCell>
        <mxCell id="f2" value="&lt;b&gt;2. Declarative Inputs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot; color=&quot;#4B5563&quot;&gt;outcomes, not steps&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F4F7FC;strokeColor=#7A99C7;strokeWidth=1;fontColor=#2E5C9E;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry width="124" height="84" as="geometry" x="180" y="40" /></mxCell>
        <mxCell id="f3" value="&lt;b&gt;3. Encapsulated Dependencies&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot; color=&quot;#4B5563&quot;&gt;owns what it needs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F4F7FC;strokeColor=#7A99C7;strokeWidth=1;fontColor=#2E5C9E;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry width="124" height="84" as="geometry" x="320" y="40" /></mxCell>
        <mxCell id="f4" value="&lt;b&gt;4. Stable Reconciliation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot; color=&quot;#4B5563&quot;&gt;safe to reapply&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F4F7FC;strokeColor=#7A99C7;strokeWidth=1;fontColor=#2E5C9E;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry width="124" height="84" as="geometry" x="460" y="40" /></mxCell>
